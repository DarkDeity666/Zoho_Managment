{
  "name": "schooldesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "go run ./apps/api",
    "build": "npm run build --workspace apps/web && go build -o .cache/schooldesk.exe ./apps/api",
    "test": "go test ./apps/api/... && npm run test --workspace apps/web",
    "zoho:token": "node scripts/zoho.mjs token",
    "zoho:plan": "node scripts/zoho.mjs plan",
    "zoho:provision": "node scripts/zoho.mjs provision"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
