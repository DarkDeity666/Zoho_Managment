# The root .env is loaded by Go and scripts. Never put secrets in VITE_* variables.
APP_MODE=demo
APP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:5173
APP_SECURE_COOKIE=false
APP_ADMIN_EMAIL=admin@school.local
APP_ADMIN_PASSWORD=change-this-to-a-long-random-password
DEMO_PARENT_PASSWORD=parent-demo-2026
DEMO_DATA_FILE=data/demo.json
SCHOOL_NAME=Greenfield Academy
SCHOOL_TIMEZONE=Asia/Kolkata
ATTENDANCE_ALERT_THRESHOLD=75

# Needed only for APP_MODE=zoho. Match the data center of YOUR Zoho account.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Temporary self-client authorization code, consumed by npm run zoho:token.
ZOHO_GRANT_CODE=
# Used only by the CRM schema provisioning command; CRM Administrator profile ID.
ZOHO_PROFILE_ID=
# Optional generated native CRM webform URL (embed link, not the post endpoint).
ZOHO_WEBFORM_EMBED_URL=

